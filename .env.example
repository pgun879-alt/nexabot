# Application
NEXABOT_ENVIRONMENT=local
NEXABOT_APP_NAME=NexaBot
NEXABOT_LOG_LEVEL=INFO
NEXABOT_LOG_FORMAT=console

# API
NEXABOT_API_HOST=127.0.0.1
NEXABOT_API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://nexabot:nexabot@localhost:5432/nexabot

# Redis
REDIS_URL=redis://localhost:6379/0

# Redis is only read by the queue adapter, so it is required in production
# only when NEXABOT_ENABLE_WORKERS=true.

# Telegram
# Required in production only when NEXABOT_ENABLE_TELEGRAM=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=false

# LLM provider
# "stub" is the only implemented provider. "openai" is recognised so that
# configuration can reject it with an accurate message; no adapter exists.
LLM_PROVIDER=stub
LLM_DEFAULT_MODEL=
OPENAI_API_KEY=

# Security / limits
# Required in production.
NEXABOT_SECRET_KEY=
# NOT ENFORCED YET: no rate limiter and no file upload path exist. These are
# validated and carried in settings so the limits are configured in one place
# when those features land. See README "Planned".
NEXABOT_MAX_REQUESTS_PER_MINUTE=60
NEXABOT_MAX_FILE_SIZE_MB=25

# Feature flags
NEXABOT_ENABLE_TELEGRAM=false
NEXABOT_ENABLE_API=true
NEXABOT_ENABLE_WORKERS=false
